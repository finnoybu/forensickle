  "can_parse": true,
  "can_retain": true,
  "parse_location": "client",
  "timeout": 300,
  "platforms": {
    "windows": {
      "source_paths": [
        "%APPDATA%\\Microsoft\\Windows\\Recent\\AutomaticDestinations\\*.automaticDestinations-ms",
        "%APPDATA%\\Microsoft\\Windows\\Recent\\CustomDestinations\\*.customDestinations-ms"
      ],
      "module": "jumplist",
      "source_type": "file"
    }
  },
  "investigative_tags": [
    "user_activity",
    "file_access",
    "execution"
  ]
}